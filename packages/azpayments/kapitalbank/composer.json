{
    "name": "azpayments/kapitalbank",
    "description": "Kapitalbank E-Commerce Payment Gateway integration for Laravel.",
    "keywords": ["laravel", "kapitalbank", "payment", "azerbaijan"],
    "license": "MIT",
    "authors": [
        {
            "name": "Elgun Heydarli",
            "email": "elgunhaydarli@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "AZPayments\\Kapitalbank\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AZPayments\\Kapitalbank\\KapitalbankServiceProvider"
            ],
            "aliases": {
                "Kapitalbank": "AZPayments\\Kapitalbank\\Facades\\Kapitalbank"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}